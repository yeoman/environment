{
  "name": "yeoman-environment",
  "version": "6.2.0",
  "description": "Handles the lifecyle and bootstrapping of generators in a specific environment",
  "keywords": [
    "development",
    "dev",
    "build",
    "tool",
    "cli",
    "scaffold",
    "scaffolding",
    "generate",
    "generator",
    "yeoman",
    "app"
  ],
  "homepage": "http://yeoman.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeoman/environment.git"
  },
  "license": "BSD-2-Clause",
  "author": "Yeoman",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.js",
  "bin": {
    "yoe": "bin/bin.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "doc": "npm run doc:generate && npm run doc:fix && npm run doc:prettier",
    "doc:fix": "sed -i -e 's:^[[:space:]]*<!--[[:space:]]*$::g' -e 's:^[[:space:]]*-->[[:space:]]*$::g' $npm_package_config_doc_path/global.html || true",
    "doc:generate": "jsdoc -c jsdoc.json -d $npm_package_config_doc_path",
    "doc:prettier": "prettier $npm_package_config_doc_path --write --ignore-path .prettierignore-doc",
    "fix": "eslint --fix && prettier . --write",
    "prepare": "npm run build",
    "pretest": "eslint && prettier . --check && tsc -p tsconfig.test.json",
    "test": "c8 --include 'src/**' esmocha --forbid-only"
  },
  "config": {
    "doc_path": "./yeoman-environment-doc"
  },
  "dependencies": {
    "@yeoman/adapter": "^4.0.2",
    "@yeoman/conflicter": "^4.1.0",
    "@yeoman/namespace": "^2.1.0",
    "@yeoman/transform": "^2.1.1",
    "@yeoman/types": "^1.11.1",
    "arrify": "^3.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "execa": "^9.6.1",
    "fly-import": "^1.0.0",
    "globby": "^16.2.0",
    "grouped-queue": "^2.1.0",
    "locate-path": "^8.0.0",
    "lodash-es": "^4.18.1",
    "mem-fs": "^4.1.4",
    "mem-fs-editor": "^12.0.4",
    "semver": "^7.7.4",
    "slash": "^5.1.0",
    "untildify": "^6.0.0",
    "which-package-manager": "^1.0.1"
  },
  "devDependencies": {
    "@node-loaders/esbuild": "^2.0.0",
    "@types/debug": "^4.1.13",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.35",
    "@types/semver": "^7.7.1",
    "@yeoman/eslint": "1.1.0",
    "c8": "^11.0.0",
    "eslint": "10.2.1",
    "esmocha": "^5.0.0",
    "jsdoc": "^4.0.5",
    "prettier": "3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "strip-ansi": "^7.2.0",
    "typescript": "6.0.3",
    "yeoman-environment": "file:./",
    "yeoman-test": "^11.3.1"
  },
  "peerDependencies": {
    "@yeoman/adapter": "^4.0.2",
    "@yeoman/types": "^1.10.3",
    "mem-fs": "^4.1.4"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "acceptDependencies": {
    "@yeoman/adapter": ">=4.0.2"
  },
  "overrides": {
    "@yeoman-environment/generator-tests": {
      "yeoman-environment": "file:./"
    }
  },
  "workspaces": [
    "test/generators"
  ]
}
