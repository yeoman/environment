    "./generator-v6": "./generator-v6.ts",
    "./generator-v7": "./generator-v7.ts",
    "./generator-v8": "./generator-v8.ts"
  },
  "dependencies": {
    "yeoman-generator-2": "npm:yeoman-generator@^2.0.5",
    "yeoman-generator-4": "npm:yeoman-generator@^4.13.0",
    "yeoman-generator-5": "npm:yeoman-generator@^5.10.0",
    "yeoman-generator-6": "npm:yeoman-generator@^6.0.1",
    "yeoman-generator-7": "npm:yeoman-generator@^7.5.1",
    "yeoman-generator-8": "npm:yeoman-generator@^8.0.0-beta.8"
